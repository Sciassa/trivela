{
  "name": "trivela",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @trivela/web dev",
    "build": "pnpm --filter @trivela/web build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "node tools/e2e.mjs",
    "data:generate": "cd data && uv run python -m trivela_data.generate",
    "data:sync": "cd data && uv run python -m trivela_data.sync",
    "preview": "pnpm --filter @trivela/web preview"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "@types/node": "22.10.2"
  }
}
